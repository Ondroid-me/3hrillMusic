    "nme.com":                      { "allow": true,  "crawl_delay": 1.0 },
    "billboard.com":                { "allow": true,  "crawl_delay": 1.5 },
    "rollingstone.com":             { "allow": true,  "crawl_delay": 1.5 },
    "stereogum.com":                { "allow": true,  "crawl_delay": 1.0 },
    "consequence.net":              { "allow": true,  "crawl_delay": 1.0 },
    "spin.com":                     { "allow": true,  "crawl_delay": 1.0 },
    "theguardian.com":              { "allow": true,  "crawl_delay": 1.0 },
    "variety.com":                  { "allow": true,  "crawl_delay": 1.5 },
    "musicbusinessworldwide.com":   { "allow": true,  "crawl_delay": 1.0 },
    "xxlmag.com":                   { "allow": true,  "crawl_delay": 1.0 },
    "okayplayer.com":               { "allow": true,  "crawl_delay": 1.0 },
    "soompi.com":                   { "allow": true,  "crawl_delay": 1.0 }
  }
}
